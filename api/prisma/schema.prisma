generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Altere para "mysql" ou "sqlite" se necessário
  url      = env("DATABASE_URL")
}

model Usuario {
  id               Int      @id @default(autoincrement())
  nome            String
  email          String   @unique
  telefone       String
  dataNascimento DateTime
  cpf            String   @unique
  endereco       String
  sexo           String
  criadoEm       DateTime @default(now())
}
